{
  "$schema": "https://opencode.ai/config.json",

  // Strong main agent
  "model": "openai/gpt-5.6-terra",
  "reasoningEffort": "medium",

  // One level of subagents is enough for now.
  // Primary -> subagent.
  "subagent_depth": 1,

  "agents": {
    // Override OpenCode's built-in general worker.
    // This handles most delegated implementation/research work.
    "general": {
      "model": "opencode/nemotron-3-ultra-free"
    },

    // Override OpenCode's built-in read-only code explorer.
    "explore": {
      "model": "opencode/nemotron-3.5-lightning-free"
    },

    // Expensive escape hatch.
    "critical": {
      "description": "Use only for unusually difficult, high-impact reasoning tasks when the normal free subagents are insufficient.",
      "mode": "subagent",
      "model": "openai/gpt-6-sol",
      "reasoningEffort": "medium"
    }
  }
}